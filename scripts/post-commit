#!/bin/sh
# neurox post-commit hook
# Reports changed files to neurox so it can mark linked observations as stale.
#
# Install: neurox install-hook
# Or manually: cp scripts/post-commit .git/hooks/post-commit && chmod +x .git/hooks/post-commit

NEUROX_PORT="${NEUROX_PORT:-7437}"
NEUROX_URL="http://localhost:${NEUROX_PORT}/api/v1/hooks/git"

# Get changed files from the last commit
CHANGED_FILES=$(git diff --name-only HEAD~1 HEAD 2>/dev/null)
if [ -z "$CHANGED_FILES" ]; then
    exit 0
fi

COMMIT_SHA=$(git rev-parse HEAD)
BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Build JSON payload
FILES_JSON=$(echo "$CHANGED_FILES" | awk 'BEGIN{printf "["} NR>1{printf ","} {printf "\"%s\"", $0} END{printf "]"}')

PAYLOAD=$(cat <<EOF
{"changed_files":${FILES_JSON},"commit_sha":"${COMMIT_SHA}","branch":"${BRANCH}"}
EOF
)

# Send to neurox (fail silently — don't block commits)
curl -s -X POST "${NEUROX_URL}" \
    -H "Content-Type: application/json" \
    -d "${PAYLOAD}" \
    --connect-timeout 2 \
    --max-time 5 \
    > /dev/null 2>&1 || true
